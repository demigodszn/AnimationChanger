-- animation_loadout_v4.lua
-- Heartbeat-driven movement animations. Run/Walk distinction removed
-- until we confirm what actually signals "sprinting" in this game.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

local loadout = {
	Idle = { id = 133806214992291, id2 = 94970088341563 },
	Walk = { id = 782843345 },
	Run = { id = 4417979645 },
	Jump = { id = 616008936 },
	Fall = { id = 616005863 },
	Climb = { id = 616003713 },
}

local activeTrackName = nil
local heartbeatConn = nil
local lastLoggedSpeed = nil

local function loadTrack(animator, id, priority)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	local track = animator:LoadAnimation(anim)
	track.Priority = priority or Enum.AnimationPriority.Movement
	return track
end

local function playState(name, tracks)
	if activeTrackName == name then return end

	for otherName, track in pairs(tracks) do
		if otherName ~= name and track.IsPlaying then
			track:Stop(0.15)
		end
	end

	local target = tracks[name]
	if target and not target.IsPlaying then
		target:Play(0.15)
	end
	activeTrackName = name
end

local function setup(char)
	local hum = char:WaitForChild("Humanoid", 10)
	local animate = char:WaitForChild("Animate", 10)
	if not hum then
		warn("[DIAG] Humanoid missing")
		return
	end

	if animate then
		animate.Disabled = true
	end

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local tracks = {
		Idle = loadTrack(animator, loadout.Idle.id, Enum.AnimationPriority.Idle),
		Walk = loadTrack(animator, loadout.Walk.id),
		Run = loadTrack(animator, loadout.Run.id),
		Jump = loadTrack(animator, loadout.Jump.id, Enum.AnimationPriority.Action),
		Fall = loadTrack(animator, loadout.Fall.id, Enum.AnimationPriority.Action),
		Climb = loadTrack(animator, loadout.Climb.id, Enum.AnimationPriority.Movement),
	}

	tracks.Idle.Looped = true
	tracks.Walk.Looped = true
	tracks.Run.Looped = true
	tracks.Climb.Looped = true

	if heartbeatConn then
		heartbeatConn:Disconnect()
	end

	heartbeatConn = RunService.Heartbeat:Connect(function()
		local state = hum:GetState()

		if state == Enum.HumanoidStateType.Jumping then
			playState("Jump", tracks)
			return
		elseif state == Enum.HumanoidStateType.Freefall then
			playState("Fall", tracks)
			return
		elseif state == Enum.HumanoidStateType.Climbing then
			playState("Climb", tracks)
			return
		end

		-- DIAG: log WalkSpeed only when it changes, so you can see if sprinting alters it at all
		if hum.WalkSpeed ~= lastLoggedSpeed then
			print("[DIAG] WalkSpeed changed to:", hum.WalkSpeed)
			lastLoggedSpeed = hum.WalkSpeed
		end

		local speed = hum.MoveDirection.Magnitude
		if speed > 0 then
			-- Run branch disabled until we confirm a real sprint signal.
			-- Currently defaults everyone to Walk regardless of speed.
			playState("Walk", tracks)
		else
			playState("Idle", tracks)
		end
	end)

	print("[DIAG] Heartbeat-driven animation loop started (Run disabled pending WalkSpeed data)")
	playState("Idle", tracks)
end

lp.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	setup(char)
end)

if lp.Character then
	setup(lp.Character)
end
