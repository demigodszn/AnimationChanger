-- animation_loadout.lua
-- Extracted bundle IDs from animationData table
-- Slots: Walk=Toy, Idle=CatwalkGram, Run=Mr. Toilet, Jump+Fall=Levitation

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local loadout = {
	Walk = { id = 782843345, source = "Toy" },
	Idle = { id = 133806214992291, id2 = 94970088341563, source = "CatwalkGram" },
	Run = { id = 4417979645, source = "Mr. Toilet" },
	Jump = { id = 616008936, source = "Levitation" },
	Fall = { id = 616005863, source = "Levitation" },
	Climb = { id = 616003713, source = "Levitation" },
}

local function clearAllAnimations()
	local char = lp.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	for _, track in pairs(hum:GetPlayingAnimationTracks()) do
		print("[DIAG] Stopping track:", track.Animation.AnimationId, "| Priority:", track.Priority.Name)
		track:Stop(0)
		track:Destroy()
	end

	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in pairs(animator:GetPlayingAnimationTracks()) do
			print("[DIAG] Stopping animator track:", track.Animation.AnimationId)
			track:Stop(0)
			track:Destroy()
		end
	end

	task.wait(0.1)
end

local function updateAnimation(animate, folderName, animName, animId)
	if not animId or animId == 0 then return end

	local folder = animate:FindFirstChild(folderName)
	if not folder then
		warn("[DIAG] Folder missing:", folderName)
		return
	end

	local anim = folder:FindFirstChild(animName)
	if anim and anim:IsA("Animation") then
		local old = anim.AnimationId
		anim.AnimationId = "rbxassetid://" .. tostring(animId)
		print("[DIAG] " .. folderName .. "/" .. animName .. ": " .. old .. " -> " .. anim.AnimationId)
	else
		warn("[DIAG] Animation instance missing:", folderName, animName)
	end
end

local function applyLoadout()
	local char = lp.Character
	if not char then
		warn("[DIAG] No character")
		return
	end

	print("[DIAG] Applying loadout to:", char.Name)
	clearAllAnimations()

	local animate = char:FindFirstChild("Animate")
	if not animate then
		warn("[DIAG] Animate script missing")
		return
	end

	animate.Disabled = true
	task.wait(0.1)

	updateAnimation(animate, "walk", "WalkAnim", loadout.Walk.id)
	updateAnimation(animate, "idle", "Animation1", loadout.Idle.id)
	updateAnimation(animate, "idle", "Animation2", loadout.Idle.id2)
	updateAnimation(animate, "run", "RunAnim", loadout.Run.id)
	updateAnimation(animate, "jump", "JumpAnim", loadout.Jump.id)
	updateAnimation(animate, "fall", "FallAnim", loadout.Fall.id)
	updateAnimation(animate, "climb", "ClimbAnim", loadout.Climb.id)

	local idleFolder = animate:FindFirstChild("idle")
	if idleFolder then
		local weight1 = idleFolder:FindFirstChild("Animation1Weight")
		local weight2 = idleFolder:FindFirstChild("Animation2Weight")
		if weight1 then weight1.Value = 9 end
		if weight2 then weight2.Value = 1 end
	end

	task.wait(0.1)
	animate.Disabled = false
	print("[DIAG] Animate re-enabled")

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Landed)
		task.wait(0.05)
		hum:ChangeState(Enum.HumanoidStateType.Running)
		task.wait(0.05)
		hum:ChangeState(Enum.HumanoidStateType.Landed)
		print("[DIAG] Humanoid state cycled to force reload")
	end

	task.wait(0.2)
	clearAllAnimations()

	task.wait(0.3)
	if hum then
		for _, track in pairs(hum:GetPlayingAnimationTracks()) do
			print("[DIAG] Now playing:", track.Animation.AnimationId, "| Priority:", track.Priority.Name)
		end
	end
end

lp.CharacterAdded:Connect(function(char)
	local hum = char:WaitForChild("Humanoid", 10)
	local animate = char:WaitForChild("Animate", 10)
	if hum and animate then
		task.wait(1)
		applyLoadout()
	else
		warn("[DIAG] Timeout waiting for Humanoid/Animate on respawn")
	end
end)

applyLoadout()
