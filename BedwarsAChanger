-- animation_loadout_direct.lua
-- Bypasses Animate entirely. Plays loadout tracks directly via Animator,
-- keyed to Humanoid state changes. Animate script is disabled permanently.

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local loadout = {
	Idle = { id = 133806214992291, id2 = 94970088341563 },
	Walk = { id = 782843345 },
	Run = { id = 4417979645 },
	Jump = { id = 616008936 },
	Fall = { id = 616005863 },
	Climb = { id = 616003713 },
}

local activeTracks = {}

local function loadTrack(animator, id, priority)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	local track = animator:LoadAnimation(anim)
	track.Priority = priority or Enum.AnimationPriority.Movement
	return track
end

local function stopAll()
	for name, track in pairs(activeTracks) do
		if track.IsPlaying then
			track:Stop(0.1)
		end
	end
end

local function playState(name, track)
	if activeTracks[name] == track and track.IsPlaying then return end
	stopAll()
	track:Play(0.1)
	activeTracks[name] = track
end

local function setup(char)
	local hum = char:WaitForChild("Humanoid", 10)
	local animate = char:WaitForChild("Animate", 10)
	if not hum then
		warn("[DIAG] Humanoid missing")
		return
	end

	-- Permanently disable Animate so it can't fight the loadout
	if animate then
		animate.Disabled = true
	end

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local tracks = {
		Idle = loadTrack(animator, loadout.Idle.id, Enum.AnimationPriority.Idle),
		Idle2 = loadout.Idle.id2 and loadTrack(animator, loadout.Idle.id2, Enum.AnimationPriority.Idle) or nil,
		Walk = loadTrack(animator, loadout.Walk.id),
		Run = loadTrack(animator, loadout.Run.id),
		Jump = loadTrack(animator, loadout.Jump.id, Enum.AnimationPriority.Action),
		Fall = loadTrack(animator, loadout.Fall.id, Enum.AnimationPriority.Action),
		Climb = loadTrack(animator, loadout.Climb.id, Enum.AnimationPriority.Movement),
	}

	tracks.Idle.Looped = true
	tracks.Walk.Looped = true
	tracks.Run.Looped = true
	tracks.Climb.Looped = true

	print("[DIAG] Direct tracks loaded, Animate disabled:", animate ~= nil)

	hum.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Running then
			local speed = hum.MoveDirection.Magnitude
			if speed > 0 then
				local isSprinting = hum.WalkSpeed > 16 -- adjust threshold if your game has different base speed
				playState(isSprinting and "Run" or "Walk", isSprinting and tracks.Run or tracks.Walk)
			else
				playState("Idle", tracks.Idle)
			end
		elseif newState == Enum.HumanoidStateType.Jumping then
			playState("Jump", tracks.Jump)
		elseif newState == Enum.HumanoidStateType.Freefall then
			playState("Fall", tracks.Fall)
		elseif newState == Enum.HumanoidStateType.Climbing then
			playState("Climb", tracks.Climb)
		elseif newState == Enum.HumanoidStateType.Landed then
			playState("Idle", tracks.Idle)
		end
	end)

	playState("Idle", tracks.Idle)
end

lp.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	setup(char)
end)

if lp.Character then
	setup(lp.Character)
end
